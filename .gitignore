# ---------- 构建产物 ----------
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
